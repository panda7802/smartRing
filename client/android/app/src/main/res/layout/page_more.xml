<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <com.zx.smartring.ui.widget.WaveHeaderView
        android:layout_width="match_parent"
        android:layout_height="181dp" />

    <TextView
        android:id="@+id/profile_avatar_more"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_circle_avatar"
        android:clickable="true"
        android:contentDescription="@string/profile_open_account"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/icon_avatar"
        android:textColor="@color/yellow"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/profile_name_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="94dp"
        android:text="@string/profile_guest"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="204dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/manual_entry"
            style="@style/ZikrCard"
            android:layout_height="78dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:text="@string/device_manual"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/about_entry"
            style="@style/ZikrCard"
            android:layout_height="78dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/about_zikr_ring"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:text="@string/version_name"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
