<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <View
        android:id="@+id/daily_calendar_status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/deep_teal" />

    <LinearLayout
        android:id="@+id/daily_calendar_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@color/deep_teal">

            <TextView
                android:id="@+id/daily_calendar_back"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/icon_back"
                android:textColor="@color/white"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/daily_calendar_title"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/ZikrCard"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp">

                        <TextView
                            android:id="@+id/daily_calendar_previous"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/daily_calendar_previous_month"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/icon_back"
                            android:textColor="@color/deep_teal"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/daily_calendar_month"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="@string/daily_calendar_month_placeholder"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/daily_calendar_next"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="end"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/daily_calendar_next_month"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/icon_calendar_next"
                            android:textColor="@color/deep_teal"
                            android:textSize="28sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/daily_calendar_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/daily_calendar_month_total_placeholder"
                        android:textColor="@color/deep_teal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:columnCount="7"
                        android:rowCount="1">

                        <TextView style="@style/CalendarWeekday" android:text="@string/weekday_monday" />
                        <TextView style="@style/CalendarWeekday" android:text="@string/weekday_tuesday" />
                        <TextView style="@style/CalendarWeekday" android:text="@string/weekday_wednesday" />
                        <TextView style="@style/CalendarWeekday" android:text="@string/weekday_thursday" />
                        <TextView style="@style/CalendarWeekday" android:text="@string/weekday_friday" />
                        <TextView style="@style/CalendarWeekday" android:text="@string/weekday_saturday" />
                        <TextView style="@style/CalendarWeekday" android:text="@string/weekday_sunday" />
                    </GridLayout>

                    <GridLayout
                        android:id="@+id/daily_calendar_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:rowCount="6" />

                    <TextView
                        android:id="@+id/daily_calendar_selection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/daily_calendar_select_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/daily_calendar_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/daily_calendar_loading"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/daily_calendar_retry"
                    android:layout_width="132dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_auth_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/daily_calendar_retry"
                    android:textColor="@color/deep_teal"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
